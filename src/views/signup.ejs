<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up · Event Management</title>
    <link rel="stylesheet" href="/css/output.css">
    <style>
        .fade-in { animation: fadeIn .7s cubic-bezier(.21, 1.02, .73, 1) forwards; }
        .slide-in { animation: slideIn .8s cubic-bezier(.21, 1.02, .73, 1) forwards; opacity: 0; }
        .float-slow { animation: floatSlow 9s ease-in-out infinite; }
        .float-slower { animation: floatSlow 13s ease-in-out infinite reverse; }
        .field-icon { transition: color .2s ease; }
        .auth-input { transition: border-color .2s ease, box-shadow .2s ease, transform .15s ease; }
        .auth-input:focus { transform: translateY(-1px); }
        .auth-input:focus ~ .field-icon-leading { color: #2563eb; }
        .strength-bar { transition: width .3s ease, background-color .3s ease; }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(18px) scale(.98); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }
        @keyframes slideIn {
            from { opacity: 0; transform: translateX(24px); }
            to { opacity: 1; transform: translateX(0); }
        }
        @keyframes floatSlow {
            0%, 100% { transform: translateY(0) translateX(0); }
            50% { transform: translateY(-22px) translateX(10px); }
        }
        @media (prefers-reduced-motion: reduce) {
            .fade-in, .slide-in, .float-slow, .float-slower { animation: none !important; }
            .slide-in { opacity: 1; }
        }
        input[type="checkbox"] { accent-color: #2563eb; }
    </style>
</head>

<body class="bg-gradient-to-br from-blue-50 via-white to-gray-100 min-h-screen flex items-center justify-center px-4 py-10 overflow-hidden">

    <!-- Decorative blurred blobs -->
    <div class="fixed w-80 h-80 bg-blue-200 rounded-full blur-3xl opacity-30 top-[-4rem] right-[-4rem] float-slow pointer-events-none"></div>
    <div class="fixed w-80 h-80 bg-indigo-300 rounded-full blur-3xl opacity-20 bottom-[-4rem] left-[-4rem] float-slower pointer-events-none"></div>
    <div class="fixed w-48 h-48 bg-blue-200 rounded-full blur-3xl opacity-20 bottom-1/3 right-1/4 float-slow pointer-events-none"></div>

    <div class="relative w-full max-w-5xl min-h-[540px] grid md:grid-cols-2 bg-white/70 backdrop-blur-xl rounded-3xl shadow-2xl border border-white/50 overflow-hidden fade-in">

        <!-- Brand / visual panel -->
        <aside class="hidden md:flex flex-col justify-between p-10 bg-gradient-to-br from-indigo-600 via-blue-700 to-blue-800 text-white slide-in">
            <div class="flex items-center gap-2">
                <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                    <path d="M16 2v4M8 2v4M3 10h18"></path>
                </svg>
                <span class="text-lg font-semibold tracking-tight">EventFlow</span>
            </div>

            <div>
                <h2 class="text-3xl font-semibold tracking-tight leading-tight mb-4">
                    Start managing your events in minutes.
                </h2>
                <p class="text-blue-100/80 text-sm leading-relaxed max-w-xs">
                    Create a free account to plan, organize, and track your events from a single elegant dashboard.
                </p>
            </div>

            <ul class="space-y-3 text-sm text-blue-50/90">
                <li class="flex items-center gap-2"><svg class="w-4 h-4 text-blue-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5"/></svg> Free for users and admins</li>
                <li class="flex items-center gap-2"><svg class="w-4 h-4 text-blue-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5"/></svg> Pick your role during signup</li>
                <li class="flex items-center gap-2"><svg class="w-4 h-4 text-blue-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5"/></svg> Protected with hashed passwords</li>
            </ul>
        </aside>

        <!-- Form panel -->
        <main class="flex flex-col justify-center p-8 sm:p-10">
            <!-- Mobile logo -->
            <div class="md:hidden flex items-center justify-center gap-2 mb-6">
                <svg class="w-6 h-6 text-blue-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                    <path d="M16 2v4M8 2v4M3 10h18"></path>
                </svg>
                <span class="text-lg font-semibold tracking-tight text-gray-800">EventFlow</span>
            </div>

            <div class="mb-6 text-center md:text-left">
                <h1 class="text-2xl sm:text-3xl font-semibold text-gray-800 tracking-tight">Create your account</h1>
                <p class="text-sm text-gray-500 mt-1">It only takes a minute to get started.</p>
            </div>

            <% if (errors && errors.length) { %>
                <div class="mb-5 p-3 bg-red-50 border border-red-200 text-red-600 rounded-xl text-sm space-y-1" role="alert">
                    <% errors.forEach(function(err) { %>
                        <p class="m-0 flex items-center gap-2">
                            <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
                            <span><%= err %></span>
                        </p>
                    <% }) %>
                </div>
            <% } %>

            <form action="/signup" method="POST" class="space-y-4" autocomplete="on">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <div class="grid sm:grid-cols-2 gap-4">
                    <!-- Full Name -->
                    <div>
                        <label for="name" class="block text-sm font-medium text-gray-600 mb-1.5">Full name</label>
                        <div class="relative">
                            <input id="name" type="text" name="name" value="<%= oldInput?.name || '' %>" required
                                class="auth-input w-full pl-3 pr-10 py-2.5 bg-white/70 border border-gray-200 rounded-xl text-gray-800 placeholder-gray-400 focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/15"
                                placeholder="John Doe" autocomplete="name">
                            <svg class="field-icon w-5 h-5 text-gray-400 absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
                            </svg>
                        </div>
                    </div>

                    <!-- Role -->
                    <div>
                        <label for="role" class="block text-sm font-medium text-gray-600 mb-1.5">Role</label>
                        <div class="relative">
                            <select id="role" name="role" required
                                class="auth-input w-full pl-3 pr-10 py-2.5 bg-white/70 border border-gray-200 rounded-xl text-gray-800 focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/15 appearance-none cursor-pointer">
                                <option value="" disabled <%= !oldInput?.role ? 'selected' : '' %>>Select role</option>
                                <option value="user" <%= oldInput?.role === 'user' ? 'selected' : '' %>>User</option>
                                <option value="admin" <%= oldInput?.role === 'admin' ? 'selected' : '' %>>Admin</option>
                            </select>
                            <svg class="field-icon w-5 h-5 text-gray-400 absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="m6 9 6 6 6-6"/>
                            </svg>
                        </div>
                    </div>
                </div>

                <!-- Email -->
                <div>
                    <label for="email" class="block text-sm font-medium text-gray-600 mb-1.5">Email</label>
                    <div class="relative">
                        <svg class="field-icon w-5 h-5 text-gray-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 5L2 7"/>
                        </svg>
                        <input id="email" type="email" name="email" value="<%= oldInput?.email || '' %>" required
                            class="auth-input w-full pl-11 pr-3 py-2.5 bg-white/70 border border-gray-200 rounded-xl text-gray-800 placeholder-gray-400 focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/15"
                            placeholder="you@example.com" autocomplete="email">
                    </div>
                </div>

                <!-- Password -->
                <div>
                    <label for="password" class="block text-sm font-medium text-gray-600 mb-1.5">Password</label>
                    <div class="relative">
                        <svg class="field-icon w-5 h-5 text-gray-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                        </svg>
                        <input id="password" type="password" name="password" required
                            class="auth-input w-full pl-11 pr-12 py-2.5 bg-white/70 border border-gray-200 rounded-xl text-gray-800 placeholder-gray-400 focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/15"
                            placeholder="••••••••" autocomplete="new-password">
                        <button type="button" id="togglePw" aria-label="Show password"
                            class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-blue-600 transition" tabindex="-1">
                            <svg class="w-5 h-5 eye-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                            <svg class="w-5 h-5 eye-closed hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 10 8 10 8a13.16 13.16 0 0 1-1.67 2.68M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9 9 0 0 0 5.39-1.61M3 3l18 18M9.9 9.9a3 3 0 0 0 4.2 4.2"/></svg>
                        </button>
                    </div>
                    <!-- Strength meter -->
                    <div class="mt-2 flex items-center gap-2">
                        <div class="flex-1 h-1.5 bg-gray-200 rounded-full overflow-hidden">
                            <div id="strengthBar" class="strength-bar h-full w-0 bg-gray-300 rounded-full"></div>
                        </div>
                        <span id="strengthLabel" class="text-xs text-gray-400 w-16 text-right">Too short</span>
                    </div>
                </div>

                <!-- Confirm Password -->
                <div>
                    <label for="confirmPassword" class="block text-sm font-medium text-gray-600 mb-1.5">Confirm password</label>
                    <div class="relative">
                        <svg class="field-icon w-5 h-5 text-gray-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                        </svg>
                        <input id="confirmPassword" type="password" name="confirmPassword" required
                            class="auth-input w-full pl-11 pr-10 py-2.5 bg-white/70 border border-gray-200 rounded-xl text-gray-800 placeholder-gray-400 focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/15"
                            placeholder="Re-enter password" autocomplete="new-password">
                        <svg id="matchIcon" class="w-5 h-5 text-gray-300 absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/>
                        </svg>
                    </div>
                    <p id="matchHint" class="text-xs text-gray-400 mt-1.5 hidden">Passwords do not match.</p>
                </div>

                <button type="submit"
                    class="w-full bg-blue-600 text-white py-2.5 rounded-xl font-medium shadow-md transition duration-300 hover:bg-blue-700 hover:shadow-xl hover:-translate-y-0.5 active:translate-y-0 active:shadow-md">
                    Create account
                </button>
            </form>

            <p class="text-center text-sm text-gray-500 mt-6">
                Already have an account?
                <a href="/login" class="text-blue-600 font-medium hover:text-blue-700 hover:underline">Log in</a>
            </p>
        </main>
    </div>

    <script>
        (function () {
            // Password show / hide
            var btn = document.getElementById('togglePw');
            var pw = document.getElementById('password');
            if (btn && pw) {
                btn.addEventListener('click', function () {
                    var show = pw.type === 'password';
                    pw.type = show ? 'text' : 'password';
                    btn.querySelector('.eye-open').classList.toggle('hidden', show);
                    btn.querySelector('.eye-closed').classList.toggle('hidden', !show);
                    btn.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
                    pw.focus();
                });
            }

            // Password strength meter
            var bar = document.getElementById('strengthBar');
            var label = document.getElementById('strengthLabel');
            var levels = [
                { w: '0%',  c: 'bg-gray-300',   t: 'Too short' },
                { w: '25%', c: 'bg-red-500',    t: 'Weak' },
                { w: '50%', c: 'bg-amber-500',  t: 'Fair' },
                { w: '75%', c: 'bg-blue-500',  t: 'Good' },
                { w: '100%',c: 'bg-emerald-500',t: 'Strong' }
            ];
            function score(v) {
                if (!v) return 0;
                var s = 0;
                if (v.length >= 8) s++;
                if (/[A-Z]/.test(v)) s++;
                if (/[0-9]/.test(v)) s++;
                if (/[^A-Za-z0-9]/.test(v)) s++;
                return Math.min(s, 4);
            }
            if (pw && bar && label) {
                pw.addEventListener('input', function () {
                    var lvl = levels[score(pw.value)];
                    bar.style.width = lvl.w;
                    bar.className = 'strength-bar h-full rounded-full ' + lvl.c;
                    label.textContent = lvl.t;
                    validateMatch();
                });
            }

            // Confirm match
            var cpw = document.getElementById('confirmPassword');
            var matchIcon = document.getElementById('matchIcon');
            var matchHint = document.getElementById('matchHint');
            function validateMatch() {
                if (!cpw.value) {
                    matchIcon.classList.remove('text-emerald-500', 'text-red-500');
                    matchIcon.classList.add('text-gray-300');
                    matchHint.classList.add('hidden');
                    return;
                }
                var ok = cpw.value === pw.value;
                matchIcon.classList.remove('text-gray-300', 'text-emerald-500', 'text-red-500');
                matchIcon.classList.add(ok ? 'text-emerald-500' : 'text-red-500');
                matchHint.textContent = ok ? 'Passwords match.' : 'Passwords do not match.';
                matchHint.classList.remove('hidden', 'text-red-500', 'text-emerald-500');
                matchHint.classList.add(ok ? 'text-emerald-500' : 'text-red-500');
            }
            if (cpw) cpw.addEventListener('input', validateMatch);
        })();
    </script>
</body>

</html>
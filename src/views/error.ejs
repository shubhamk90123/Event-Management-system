<!DOCTYPE html>
<html lang="en">

  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
      <%= title %> | Event Management
    </title>
    <link rel="stylesheet" href="/css/output.css">
    <style>
      .fade-in {
        animation: fadeIn 0.5s ease forwards;
      }

      @keyframes fadeIn {
        from {
          opacity: 0;
          transform: translateY(12px);
        }

        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
    </style>
  </head>

  <body
    class="min-h-screen bg-gradient-to-br from-blue-50 via-white to-orange-50 flex items-center justify-center px-4 py-10">

    <main class="w-full max-w-lg fade-in">
      <div
        class="bg-white/80 backdrop-blur-xl border border-white/50 rounded-3xl shadow-xl p-8 md:p-10 text-center">

        <div class="mb-6">
          <span
            class="inline-flex items-center justify-center w-24 h-24 rounded-full <%= statusCode === 404 ? 'bg-blue-100 text-blue-600' : 'bg-red-100 text-red-600' %>">
            <span class="text-4xl font-bold">
              <%= statusCode %>
            </span>
          </span>
        </div>

        <h1 class="text-2xl md:text-3xl font-bold text-gray-800 mb-3">
          <%= title %>
        </h1>

        <p class="text-gray-600 leading-relaxed mb-8">
          <%= message %>
        </p>

        <% if (isDevelopment && stack) { %>
          <div class="text-left mb-8">
            <details class="group bg-gray-50 rounded-lg border border-gray-200 overflow-hidden">
              <summary
                class="cursor-pointer px-4 py-3 text-sm font-medium text-gray-700 hover:bg-gray-100 select-none">
                Developer details
              </summary>
              <pre
                class="px-4 py-3 text-xs text-red-700 bg-red-50 overflow-auto max-h-80 whitespace-pre-wrap"><%= stack %></pre>
            </details>
          </div>
          <% } %>

            <div class="flex flex-col sm:flex-row gap-3 justify-center">
              <a href="/"
                class="inline-flex items-center justify-center bg-blue-600 text-white px-6 py-2.5 rounded-xl font-medium transition hover:bg-blue-700 hover:shadow-lg hover:-translate-y-0.5">
                Back to Home
              </a>
              <button onclick="history.back()"
                class="inline-flex items-center justify-center bg-white text-gray-700 border border-gray-200 px-6 py-2.5 rounded-xl font-medium transition hover:bg-gray-50 hover:border-gray-300">
                Go Back
              </button>
            </div>

      </div>

      <p class="text-center text-xs text-gray-400 mt-6">
        Event Management System
      </p>
    </main>

  </body>

</html>

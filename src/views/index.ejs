<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EventFlow · Event Management</title>
    <link rel="stylesheet" href="/css/output.css">
    <style>
        .fade-in { animation: fadeIn .7s cubic-bezier(.21, 1.02, .73, 1) both; }
        .fade-up { animation: fadeUp .8s cubic-bezier(.21, 1.02, .73, 1) both; }
        .float-slow { animation: floatSlow 9s ease-in-out infinite; }
        .float-slower { animation: floatSlow 13s ease-in-out infinite reverse; }
        .feature-card { transition: transform .3s ease, box-shadow .3s ease, border-color .3s ease; }
        .feature-card:hover { transform: translateY(-6px); }
        .reveal { opacity: 0; transform: translateY(24px); transition: opacity .7s cubic-bezier(.21,1.02,.73,1), transform .7s cubic-bezier(.21,1.02,.73,1); }
        .reveal.is-visible { opacity: 1; transform: translateY(0); }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(18px) scale(.98); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }
        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(26px); }
            to { opacity: 1; transform: translateY(0); }
        }
        @keyframes floatSlow {
            0%, 100% { transform: translateY(0) translateX(0); }
            50% { transform: translateY(-22px) translateX(10px); }
        }
        @media (prefers-reduced-motion: reduce) {
            .fade-in, .fade-up, .float-slow, .float-slower { animation: none !important; }
            .reveal { transition: none; opacity: 1; transform: none; }
        }
    </style>
</head>

<body class="bg-gradient-to-br from-blue-50 via-white to-gray-100 min-h-screen flex flex-col relative overflow-x-hidden">

    <!-- Decorative blurred blobs -->
    <div class="fixed w-96 h-96 bg-blue-200 rounded-full blur-3xl opacity-30 top-[-6rem] left-[-6rem] float-slow pointer-events-none"></div>
    <div class="fixed w-96 h-96 bg-indigo-300 rounded-full blur-3xl opacity-20 bottom-[-6rem] right-[-6rem] float-slower pointer-events-none"></div>
    <div class="fixed w-56 h-56 bg-blue-200 rounded-full blur-3xl opacity-20 top-1/4 right-1/4 float-slow pointer-events-none"></div>

    <!-- Navbar -->
    <header class="relative z-10 px-6 sm:px-10 py-5">
        <nav class="max-w-6xl mx-auto flex items-center justify-between fade-in">
            <div class="flex items-center gap-2">
                <svg class="w-7 h-7 text-blue-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                    <path d="M16 2v4M8 2v4M3 10h18"></path>
                </svg>
                <span class="text-lg font-semibold tracking-tight text-gray-800">EventFlow</span>
            </div>
            <div class="flex items-center gap-2 sm:gap-4">
                <a href="/login" class="hidden sm:inline text-sm font-medium text-gray-600 hover:text-blue-600 transition">Log in</a>
                <a href="/signup" class="text-sm font-medium text-white bg-blue-600 px-4 py-2 rounded-xl shadow-md transition duration-300 hover:bg-blue-700 hover:shadow-xl hover:-translate-y-0.5">
                    Get started
                </a>
            </div>
        </nav>
    </header>

    <!-- Hero -->
    <main class="relative z-10 flex-1 flex flex-col items-center justify-center px-6 sm:px-10 py-12 sm:py-16">
        <div class="max-w-3xl text-center fade-in">
            <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/70 backdrop-blur border border-white/50 text-xs font-medium text-blue-700 shadow-sm">
                <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
                Modern event management, simplified
            </span>
            <h1 class="mt-6 text-4xl sm:text-5xl md:text-6xl font-semibold tracking-tight text-gray-800 leading-[1.05]">
                Manage every event,<br class="hidden sm:block">
                <span class="bg-gradient-to-r from-blue-600 to-indigo-600 bg-clip-text text-transparent">effortlessly.</span>
            </h1>
            <p class="mt-6 text-gray-500 text-base sm:text-lg leading-relaxed max-w-xl mx-auto">
                Plan, create, and oversee your events from one clean, beautiful dashboard. Built for both organizers and admins.
            </p>
            <div class="mt-9 flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4">
                <a href="/signup" class="w-full sm:w-auto px-7 py-3 rounded-xl bg-blue-600 text-white font-medium shadow-lg transition duration-300 hover:bg-blue-700 hover:shadow-xl hover:-translate-y-0.5">
                    Create your account
                </a>
                <a href="/login" class="w-full sm:w-auto px-7 py-3 rounded-xl bg-white/80 backdrop-blur text-gray-700 font-medium border border-gray-200 transition duration-300 hover:bg-white hover:shadow-md hover:-translate-y-0.5">
                    Log in
                </a>
            </div>
            <p class="text-xs text-gray-400 mt-6">Free to use • No credit card required</p>
        </div>

        <!-- Feature cards -->
        <div class="mt-16 sm:mt-20 grid sm:grid-cols-3 gap-5 sm:gap-6 max-w-4xl w-full">
            <div class="reveal feature-card bg-white/70 backdrop-blur-xl p-6 rounded-2xl border border-white/50 shadow-md">
                <div class="w-11 h-11 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center mb-4">
                    <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 5v14M5 12h14"/>
                    </svg>
                </div>
                <h3 class="font-semibold text-gray-800 mb-1.5">Create events</h3>
                <p class="text-sm text-gray-500 leading-relaxed">Spin up new events in seconds with a streamlined creation flow.</p>
            </div>
            <div class="reveal feature-card bg-white/70 backdrop-blur-xl p-6 rounded-2xl border border-white/50 shadow-md" style="transition-delay:.1s">
                <div class="w-11 h-11 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center mb-4">
                    <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 9h6M9 13h6M9 17h3"/>
                    </svg>
                </div>
                <h3 class="font-semibold text-gray-800 mb-1.5">Admin overview</h3>
                <p class="text-sm text-gray-500 leading-relaxed">A real-time dashboard gives admins full control of every event.</p>
            </div>
            <div class="reveal feature-card bg-white/70 backdrop-blur-xl p-6 rounded-2xl border border-white/50 shadow-md" style="transition-delay:.2s">
                <div class="w-11 h-11 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center mb-4">
                    <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                    </svg>
                </div>
                <h3 class="font-semibold text-gray-800 mb-1.5">Secure access</h3>
                <p class="text-sm text-gray-500 leading-relaxed">Hashed passwords and session-based auth keep your data protected.</p>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="relative z-10 px-6 sm:px-10 py-6">
        <div class="max-w-6xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-3 text-sm text-gray-400">
            <p>Designed for simplicity • Built for performance</p>
            <p>© <span id="year"></span> EventFlow</p>
        </div>
    </footer>

    <script>
        (function () {
            // Scroll-reveal for feature cards
            var els = document.querySelectorAll('.reveal');
            if (!('IntersectionObserver' in window) || !els.length) {
                els.forEach(function (e) { e.classList.add('is-visible'); });
                return;
            }
            var io = new IntersectionObserver(function (entries) {
                entries.forEach(function (en) {
                    if (en.isIntersecting) {
                        en.target.classList.add('is-visible');
                        io.unobserve(en.target);
                    }
                });
            }, { threshold: 0.15 });
            els.forEach(function (e) { io.observe(e); });

            // Current year in footer
            var y = document.getElementById('year');
            if (y) y.textContent = new Date().getFullYear();
        })();
    </script>
</body>

</html>